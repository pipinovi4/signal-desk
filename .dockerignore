# Build Python services with the repository root as the build context:
# docker build -f backend/Dockerfile .
# Keep pyproject.toml, lockfiles, README.md, LICENSE, source, migrations,
# tests and service configuration available to build and test stages.

# Version control and development tools
**/.git
**/.github
**/.gitignore
**/.gitkeep
**/.idea
**/.vscode
**/.fleet
**/.history
**/.codex
**/.agents
**/*.iml
**/*.ipr
**/*.iws
**/*.code-workspace

# Secrets and local environment configuration
# Exclude templates too: inject runtime configuration outside the image.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/secrets
**/.secrets
**/credentials
**/.credentials
**/credentials.json
**/credentials.*.json
**/client_secret*.json
**/service-account*.json
**/service_account*.json
