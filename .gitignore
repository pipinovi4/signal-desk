# SignalDesk: local artifacts and sensitive files.
# Keep source, migrations, Dockerfiles, Compose files and dependency lockfiles.
# Gitignore does not protect secrets in files already tracked by Git.

# Environment variables (commit only sanitized templates)
.env
.env.*
*.env
*.env.*
.envrc
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
*.tsbuildinfo

