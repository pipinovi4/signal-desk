# Copy this file to .env and replace every placeholder before production startup.
POSTGRES_DB=signaldesk
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=replace-with-a-strong-password

RABBITMQ_USER=signaldesk
RABBITMQ_PASSWORD=replace-with-a-strong-password

# URL-encode credentials when they contain reserved URL characters.
DATABASE_URL=postgresql+asyncpg://signaldesk:replace-with-url-encoded-password@postgres:5432/signaldesk
AMQP_URL=amqp://signaldesk:replace-with-url-encoded-password@rabbitmq:5672/

TELEGRAM_BOT_TOKEN=replace-with-a-bot-token
